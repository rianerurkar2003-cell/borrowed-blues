MONGO_URL=mongodb://localhost:27017
DB_NAME=borrowed_blues

# The real therapist account. Always created/kept in sync on boot.
ADMIN_EMAIL=therapist@example.com
ADMIN_PASSWORD=change-me

JWT_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=*

# Set to false over plain HTTP (local dev); true (default) is required for
# HTTPS deployments so auth cookies are accepted cross-site.
COOKIE_SECURE=true

# Demo/dev fixture data: a sample client account plus sample appointments,
# journal entries, homework, and consultation requests. Leave true for local
# development and demos. Set to false for production so a fresh deploy stays
# empty apart from the real therapist account above.
SEED_DEMO_DATA=true

# Only read when SEED_DEMO_DATA=true.
CLIENT_SEED_EMAIL=client@example.com
CLIENT_SEED_PASSWORD=change-me

# Outbound email (password reset links). Leave SMTP_HOST empty for local dev
# — mail.py logs the message instead of sending it. Set all of these in
# production or reset links will never reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Borrowed Blues <no-reply@borrowedblues.com>

# Origin used to build links inside emails (the password reset URL).
FRONTEND_URL=http://localhost:3000
