# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=borrowed_blues
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=borrowed_blues_dev

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=therapist@borrowedblues.com
ADMIN_PASSWORD=change-me

# --- CORS / cookies ---
# "*" (open) for dev/preview, or a comma-separated allow-list of real origins in prod.
CORS_ORIGINS=*
# Cookies default to production-safe (Secure + SameSite=None). Set to false only
# for local HTTP dev, where SameSite=Lax is used instead.
COOKIE_SECURE=false

# Dev/demo fixture data (seed.js): the demo client account and its sample
# appointments/journal/homework/consultation requests. Set false in production.
SEED_DEMO_DATA=true
# Only read when SEED_DEMO_DATA=true.
CLIENT_SEED_EMAIL=client@example.com
CLIENT_SEED_PASSWORD=change-me

# --- Outbound email (password reset links) ---
# Leave SMTP_HOST empty for local dev — mail.js logs the message instead of
# sending it. Set all of these in production or reset links won't be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Borrowed Blues <no-reply@borrowedblues.com>

# Origin used to build links inside emails (the password reset URL).
FRONTEND_URL=http://localhost:3000

# --- Google Calendar sync (optional) ---
# Leave GOOGLE_CLIENT_ID empty to skip entirely -- the app boots fine and
# /therapist/google/* just reports "not connected". To enable: Google Cloud
# Console -> APIs & Services -> Credentials -> create an OAuth 2.0 Client ID
# (type "Web application") after enabling the Calendar API and configuring
# the OAuth consent screen. Add this exact redirect URI to the client:
#   GOOGLE_REDIRECT_URI value below (use your real domain in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/therapist/google/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
# Encrypts stored OAuth tokens at rest. Leave empty to store them in plain
# text (fine for local dev; a random long value is strongly recommended in
# production). Any string works -- it's hashed into an AES-256 key.
GOOGLE_TOKEN_ENCRYPTION_KEY=

PORT=8000
