# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=borrowed_blues
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=borrowed_blues_dev

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=therapist@borrowedblues.com
ADMIN_PASSWORD=change-me

# --- CORS / cookies ---
# "*" (open) for dev/preview, or a comma-separated allow-list of real origins in prod.
CORS_ORIGINS=*
# Cookies default to production-safe (Secure + SameSite=None). Set to false only
# for local HTTP dev, where SameSite=Lax is used instead.
COOKIE_SECURE=false

# Dev/demo fixture data (seed.js): the demo client account and its sample
# appointments/journal/homework/consultation requests. Set false in production.
SEED_DEMO_DATA=true
# Only read when SEED_DEMO_DATA=true.
CLIENT_SEED_EMAIL=client@example.com
CLIENT_SEED_PASSWORD=change-me

# --- Outbound email (password reset links) ---
# Leave SMTP_HOST empty for local dev — mail.js logs the message instead of
# sending it. Set all of these in production or reset links won't be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Borrowed Blues <no-reply@borrowedblues.com>

# Origin used to build links inside emails (the password reset URL).
FRONTEND_URL=http://localhost:3000

PORT=8000
