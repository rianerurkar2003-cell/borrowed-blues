# Local dev (craco start) reads .env; production builds (craco build) read
# .env.production instead -- see craco.config.js. Both files are gitignored,
# so .env.production must exist locally before running `npm run build` for
# deploy, or the build silently bakes in whatever .env says instead.
REACT_APP_BACKEND_URL=http://localhost:8000

# frontend/.env.production should instead contain:
# REACT_APP_BACKEND_URL=https://api.borrowedblues.com
